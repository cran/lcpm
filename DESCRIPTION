Package: lcpm
Type: Package
Title: Ordinal Outcomes: Generalized Linear Models with the Log Link
Version: 0.1.2
Authors@R: c(
    person(given = "Gurbakhshash",
           family = "Singh",
           role = c("aut", "cre"),
           email = "gsingh@ccsu.edu"),
    person(given = c("Gordon", "Hilton"),
           family = "Fick",
           role = "aut")
